{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/photography/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    }
  ]
}
