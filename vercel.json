{
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "",
  "outputDirectory": "new-site",
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/photography/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/connect",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/tools/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
