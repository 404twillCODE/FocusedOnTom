{
  "name": "focused-on-tom-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3851",
    "test": "tsx --test tests/photos.test.mjs tests/preview-cache.test.mjs tests/portfolio-photos.test.mjs tests/album-groups.test.mjs tests/contact-form.test.mjs tests/react-ui.test.mjs tests/scene-performance.test.mjs",
    "dev:old": "npm --prefix old run dev",
    "dev:legacy": "npm --prefix legacy-site run dev",
    "dev:original": "npm --prefix focusedontom run dev -- --webpack --port 3003",
    "setup:archives": "npm --prefix old ci && npm --prefix legacy-site ci",
    "dev:previous": "node --env-file-if-exists=.env.local scripts/previous-site.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3851",
    "typecheck": "tsc --noEmit",
    "verify:migration": "node scripts/verify-react-migration.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
